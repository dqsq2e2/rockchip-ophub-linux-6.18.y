/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>
#include "rk3588.dtsi"

/ {
	model = "SMDT AIOT-3588A V2.0";
	compatible = "smdt,aiot-3588a2", "rockchip,rk3588";

	aliases {
		ethernet0 = &gmac1;
		mmc0 = &sdhci;
		mmc1 = &sdmmc;
	};

	chosen {
		stdout-path = "serial1:1500000n8";
	};

	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 1>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		download-key {
			label = "Download";
			linux,code = <KEY_RESTART>;
			press-threshold-microvolt = <200000>;
		};
	};

	fan: pwm-fan {
		compatible = "pwm-fan";
		#cooling-cells = <2>;
		pwms = <&pwm12 0 50000 PWM_POLARITY_INVERTED>;
		cooling-levels = <0 102 170 230>;
	};

	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi1_connector: endpoint {
				remote-endpoint = <&hdmi1_to_connector>;
			};
		};
	};

	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "ES8388";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,cpu {
			sound-dai = <&i2s0_8ch>;
		};
		simple-audio-card,codec {
			sound-dai = <&es8388>;
		};
	};

	sdio_pwrseq: mmc-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rtc>;
		clock-names = "ext_clock";
		post-power-on-delay-ms = <200>;
		reset-gpios = <&gpio0 RK_PC4 GPIO_ACTIVE_LOW>;
	};

	vcc3v3_pcie: regulator-vcc3v3-pcie {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_pcie30";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio1 RK_PA4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <5000>;
	};

	vcc3v3_sd: regulator-vcc3v3-sd {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3_sd_s0";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vcc5v0_peripherals: regulator-vcc5v0-peripherals {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_peripherals";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio3 RK_PD5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
	};

	vbus_typec: regulator-vbus-typec {
		compatible = "regulator-fixed";
		regulator-name = "vbus_typec";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio4 RK_PA1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&vcc5v0_peripherals>;
	};
};

&gmac1 {
	clock_in_out = "output";
	phy-handle = <&rgmii_phy1>;
	phy-mode = "rgmii-rxid";
	pinctrl-names = "default";
	pinctrl-0 = <&gmac1_miim &gmac1_tx_bus2 &gmac1_rx_bus2
		     &gmac1_rgmii_clk &gmac1_rgmii_bus>;
	tx_delay = <0x43>;
	status = "okay";
};

&mdio1 {
	rgmii_phy1: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
		reset-gpios = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
		reset-assert-us = <20000>;
		reset-deassert-us = <100000>;
	};
};

&i2c6 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6m0_xfer>;
	status = "okay";

	rtc: rtc@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		#clock-cells = <0>;
		clock-output-names = "rtc-clkout";
		wakeup-source;
	};

	nca9555: gpio@20 {
		compatible = "novosense,nca9555", "nxp,pca9555";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	usb-typec@4e {
		compatible = "hynetek,husb311", "richtek,rt1711h";
		reg = <0x4e>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PD3 IRQ_TYPE_LEVEL_LOW>;
		vbus-supply = <&vbus_typec>;

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "sink";
			data-role = "device";
		};
	};
};

&i2c7 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c7m0_xfer>;
	status = "okay";

	es8388: audio-codec@11 {
		compatible = "everest,es8388";
		reg = <0x11>;
		#sound-dai-cells = <0>;
	};
};

&i2s0_8ch {
	pinctrl-names = "default";
	pinctrl-0 = <&i2s0_lrck &i2s0_sclk &i2s0_sdi0 &i2s0_sdo0>;
	status = "okay";
};

&pcie30phy {
	status = "okay";
};

&pcie3x4 {
	num-lanes = <4>;
	reset-gpios = <&nca9555 15 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie>;
	status = "okay";
};

&combphy0_ps {
	assigned-clocks = <&cru CLK_REF_PIPE_PHY0>;
	assigned-clock-rates = <100000000>;
	status = "okay";
};

&combphy2_psu {
	status = "okay";
};

&sata0 {
	status = "okay";
};

&saradc {
	vref-supply = <&avcc_1v8_s0>;
	status = "okay";
};

&sdhci {
	bus-width = <8>;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	no-sd;
	no-sdio;
	non-removable;
	status = "okay";
};

&sdmmc {
	bus-width = <4>;
	cap-sd-highspeed;
	cd-gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_LOW>;
	disable-wp;
	no-mmc;
	no-sdio;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_bus4 &sdmmc_clk &sdmmc_cmd>;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc3v3_sd>;
	vqmmc-supply = <&vccio_sd_s0>;
	status = "okay";
};

&spi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi2m2_cs0 &spi2m2_pins>;
	status = "okay";

	pmic@0 {
		compatible = "rockchip,rk806";
		reg = <0>;
		spi-max-frequency = <1000000>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA7 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_int>;
		system-power-controller;

		regulators {
			vdd_gpu_s0: dcdc-reg1 {
				regulator-name = "vdd_gpu_s0";
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <12500>;
				regulator-boot-on;
			};

			avcc_1v8_s0: pldo-reg1 {
				regulator-name = "avcc_1v8_s0";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			vccio_sd_s0: pldo-reg5 {
				regulator-name = "vccio_sd_s0";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
			};
		};
	};
};

&sdio {
	bus-width = <4>;
	disable-wp;
	cap-sdio-irq;
	keep-power-in-suspend;
	mmc-pwrseq = <&sdio_pwrseq>;
	no-mmc;
	no-sd;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&wifi_sdio_m0>;
	sd-uhs-sdr104;
	status = "okay";
};

&pinctrl {
	pmic {
		pmic_int: pmic-int {
			rockchip,pins = <0 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	sdio {
		wifi_sdio_m0: wifi-sdio-m0 {
			rockchip,pins = <2 RK_PB3 2 &pcfg_pull_none>,
					<2 RK_PB2 2 &pcfg_pull_up>,
					<2 RK_PA6 2 &pcfg_pull_up>,
					<2 RK_PA7 2 &pcfg_pull_up>,
					<2 RK_PB0 2 &pcfg_pull_up>,
					<2 RK_PB1 2 &pcfg_pull_up>;
		};
	};
};

&gpu {
	mali-supply = <&vdd_gpu_s0>;
	status = "okay";
};

&pwm12 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm12m1_pins>;
	status = "okay";
};

&package_thermal {
	trips {
		fan_warm: fan-warm {
			temperature = <50000>;
			hysteresis = <3000>;
			type = "active";
		};
		fan_hot: fan-hot {
			temperature = <60000>;
			hysteresis = <3000>;
			type = "active";
		};
		fan_high: fan-high {
			temperature = <70000>;
			hysteresis = <3000>;
			type = "active";
		};
	};

	cooling-maps {
		fan-map-warm {
			trip = <&fan_warm>;
			cooling-device = <&fan 1 1>;
		};
		fan-map-hot {
			trip = <&fan_hot>;
			cooling-device = <&fan 2 2>;
		};
		fan-map-high {
			trip = <&fan_high>;
			cooling-device = <&fan 3 3>;
		};
	};
};

&tsadc {
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1m1_xfer>;
	status = "okay";
};

&u2phy0 { status = "okay"; };
&u2phy0_otg { status = "okay"; };
&u2phy1 { status = "okay"; };
&u2phy1_otg { status = "okay"; };
&u2phy2 { status = "okay"; };
&u2phy2_host { status = "okay"; };
&u2phy3 { status = "okay"; };
&u2phy3_host { status = "okay"; };
&usbdp_phy0 { status = "okay"; };
&usbdp_phy1 { status = "okay"; };

&usb_host0_xhci {
	dr_mode = "peripheral";
	status = "okay";
};

&usb_host1_xhci {
	dr_mode = "host";
	status = "okay";
};

&usb_host2_xhci { status = "okay"; };
&usb_host0_ehci { status = "okay"; };
&usb_host0_ohci { status = "okay"; };
&usb_host1_ehci { status = "okay"; };
&usb_host1_ohci { status = "okay"; };

&gpio4 {
	hdmi1-enable-hog {
		gpio-hog;
		gpios = <RK_PA0 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "hdmi1-enable";
	};
};

&hdmi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&hdmim2_tx1_cec &hdmim0_tx1_hpd
		     &hdmim1_tx1_scl &hdmim1_tx1_sda>;
	status = "okay";
};

&hdmi1_in {
	hdmi1_from_vp1: endpoint {
		remote-endpoint = <&vp1_to_hdmi1>;
	};
};

&hdmi1_out {
	hdmi1_to_connector: endpoint {
		remote-endpoint = <&hdmi1_connector>;
	};
};

&hdmi1_sound { status = "okay"; };
&hdptxphy1 { status = "okay"; };
&vop { status = "okay"; };
&vop_mmu { status = "okay"; };

&hdmi_receiver_cma {
	/delete-property/ no-map;
	alignment = <0 0x800000>;
	reusable;
	status = "okay";
};

&hdmi_receiver {
	hpd-gpios = <&gpio1 RK_PD5 GPIO_ACTIVE_LOW>;
	pinctrl-names = "default";
	pinctrl-0 = <&hdmim1_rx_cec &hdmim1_rx_hpdin
		     &hdmim1_rx_scl &hdmim1_rx_sda>;
	status = "okay";
};

&vp1 {
	vp1_to_hdmi1: endpoint@ROCKCHIP_VOP2_EP_HDMI1 {
		reg = <ROCKCHIP_VOP2_EP_HDMI1>;
		remote-endpoint = <&hdmi1_from_vp1>;
	};
};
