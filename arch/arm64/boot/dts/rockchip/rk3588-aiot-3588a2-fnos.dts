#include "rk3588-aiot-3588a2.dts"

/* Use the Rockchip MPP bindings expected by the distribution kernel. */
/delete-node/ &vpu121;
/delete-node/ &vpu121_mmu;
/delete-node/ &vepu121_0;
/delete-node/ &vepu121_0_mmu;
/delete-node/ &vepu121_1;
/delete-node/ &vepu121_1_mmu;
/delete-node/ &vepu121_2;
/delete-node/ &vepu121_2_mmu;
/delete-node/ &vepu121_3;
/delete-node/ &vepu121_3_mmu;
/delete-node/ &vdec0;
/delete-node/ &vdec0_mmu;
/delete-node/ &vdec1;
/delete-node/ &vdec1_mmu;
/delete-node/ &av1d_mmu;

#include "rk3588s-vpu.dtsi"

/* Match the Mali CSF driver and clock/IRQ names shipped with fnOS. */
&gpu {
	compatible = "rockchip,rk3588-mali-csf", "arm,mali-valhall";
	clocks = <&scmi_clk SCMI_CLK_GPU>, <&cru CLK_GPU_COREGROUP>,
		 <&cru CLK_GPU_STACKS>, <&cru CLK_GPU>;
	clock-names = "clk_mali", "clk_gpu_coregroup", "clk_gpu_stacks", "clk_gpu";
	interrupts = <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH 0>,
		     <GIC_SPI 93 IRQ_TYPE_LEVEL_HIGH 0>,
		     <GIC_SPI 92 IRQ_TYPE_LEVEL_HIGH 0>;
	interrupt-names = "GPU", "MMU", "JOB";
	mem-supply = <&vdd_gpu_s0>;
	upthreshold = <60>;
	downdifferential = <30>;
	power-off-delay-ms = <200>;
};

&system_sram2 {
	/delete-node/ codec-sram@0;
	/delete-node/ codec-sram@78000;
};

&{/spi@feb20000/pmic@0/regulators} {
	vdd_vdenc_s0: dcdc-reg4 {
		regulator-name = "vdd_vdenc_s0";
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <950000>;
		regulator-ramp-delay = <12500>;
		regulator-always-on;
		regulator-boot-on;
	};
};

&rkvenc_ccu {
	status = "okay";
};

&rkvenc0 {
	venc-supply = <&vdd_vdenc_s0>;
	mem-supply = <&vdd_vdenc_s0>;
	status = "okay";
};

&rkvenc0_mmu {
	status = "okay";
};

&rkvenc1 {
	venc-supply = <&vdd_vdenc_s0>;
	mem-supply = <&vdd_vdenc_s0>;
	status = "okay";
};

&rkvenc1_mmu {
	status = "okay";
};

&es8388 {
	/* This clock provider does not expose the separate GRF output gate. */
	clocks = <&cru I2S0_8CH_MCLKOUT>;
};

/* The distribution RKNPU driver exposes all three cores as one device. */
/delete-node/ &rknn_core_0;
/delete-node/ &rknn_core_1;
/delete-node/ &rknn_core_2;
/delete-node/ &rknn_mmu_0;
/delete-node/ &rknn_mmu_1;
/delete-node/ &rknn_mmu_2;

&otp {
	specification_serial_number: specification-serial-number@6 {
		reg = <0x06 0x1>;
		bits = <0 5>;
	};

	customer_demand: customer-demand@22 {
		reg = <0x22 0x1>;
		bits = <4 4>;
	};
};

#include "rk3588s-npu.dtsi"

/ {
	vcc5v0_sys: regulator-vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};
};

&i2c1 {
	pinctrl-0 = <&i2c1m2_xfer>;
	status = "okay";

	vdd_npu_s0: regulator@42 {
		compatible = "rockchip,rk8602";
		reg = <0x42>;
		fcs,suspend-voltage-selector = <1>;
		regulator-name = "vdd_npu_s0";
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <950000>;
		regulator-ramp-delay = <2300>;
		regulator-boot-on;
		regulator-always-on;
		vin-supply = <&vcc5v0_sys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
};

&rknpu {
	rknpu-supply = <&vdd_npu_s0>;
	mem-supply = <&vdd_npu_s0>;
	status = "okay";
};

&rknpu_mmu {
	power-domains = <&power RK3588_PD_NPUTOP>;
	status = "okay";
};

/* Match the Rockchip RGA scheduler shipped with the distribution kernel. */
&rga3_core0 {
	compatible = "rockchip,rga3_core0";
	interrupt-names = "rga3_core0_irq";
	clock-names = "aclk_rga3_0", "hclk_rga3_0", "clk_rga3_0";
};

&rga3_core1 {
	compatible = "rockchip,rga3_core1";
	interrupt-names = "rga3_core1_irq";
	clock-names = "aclk_rga3_1", "hclk_rga3_1", "clk_rga3_1";
};

&rga {
	compatible = "rockchip,rga2_core0";
	interrupt-names = "rga2_irq";
	clock-names = "aclk_rga2", "hclk_rga2", "clk_rga2";
};
