#!/bin/sh
# Generate the ASCII recovery login banner; refresh redraws tty1 only.

mode="$1"

{
	if [ "$mode" = refresh ]; then printf '\0338\033[0J'; else printf '\0337'; fi
	printf '\n%s\n' "rk3588 AIUI Recovery"
	printf 'Web: '
	ip -4 -o addr show scope global 2>/dev/null |
		awk '{split($4,x,"/"); printf "http://%s/  ",x[1]}'
	printf '\nSSH / serial login: root / root\n\n'
} > /etc/issue.tmp

if cmp -s /etc/issue.tmp /etc/issue 2>/dev/null; then
	rm -f /etc/issue.tmp
	exit 0
fi
mv /etc/issue.tmp /etc/issue

if [ "$mode" = refresh ]; then
	for p in $(pidof getty); do
		tty=$(tr '\0' ' ' < /proc/$p/cmdline 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i ~ /^tty/) print $i}')
		case "$tty" in
		tty1) kill "$p" 2>/dev/null ;;
		esac
	done
fi
