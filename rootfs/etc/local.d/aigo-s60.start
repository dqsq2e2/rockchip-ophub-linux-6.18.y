#!/bin/sh

echo 1 > /proc/sys/net/ipv4/ip_forward

if [ -e /dev/mmcblk0p4 ]; then
	mkdir -p /recovery
	mount /dev/mmcblk0p4 /recovery
fi

#iptables -t nat -A POSTROUTING -s 192.168.98.0/24 -o eth2 -j MASQUERADE
iptables -t nat -A POSTROUTING -s 192.168.98.0/24 -o br0 -j MASQUERADE

/rkdev_arm64 &

/usr/sbin/aigo-s60-issue

sync

exit 0

