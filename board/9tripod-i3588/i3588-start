#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mkdir -p /run/sshd /var/empty
chmod 755 /var/empty
syslogd -C256
mdev -s
for module in r8169 dwmac-rk phy-rockchip-usbdp gpio-fan rockchip_canfd brcmfmac brcmfmac_wcc brcmfmac_cyw hci_uart btbcm snd_soc_es8328_i2c st_accel_i2c synopsys-hdmirx; do
    modprobe "$module" 2>/dev/null || :
done
ip link set lo up
/usr/sbin/i3588-issue
/usr/sbin/i3588-network &
ssh-keygen -A
/usr/sbin/sshd
/rkdev_arm64 >/tmp/rkdev-console.log 2>&1 &
echo '9Tripod I3588 Recovery: root / root'
