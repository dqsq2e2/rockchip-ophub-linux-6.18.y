#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
ip link add br0 type bridge
ip addr add 192.168.88.1/24 dev br0
ip link set br0 up
mkdir -p /run/dnsmasq
dnsmasq --conf-file=/etc/aiot3588a2-dnsmasq.conf >/tmp/dnsmasq.log 2>&1

wan=
for attempt in $(seq 1 20); do
    for path in /sys/class/net/eth*; do
        [ -e "$path/device" ] || continue
        case "$(readlink -f "$path/device")" in
            *fe1c0000.ethernet*) wan=${path##*/} ;;
        esac
    done
    [ -z "$wan" ] || break
    sleep 1
done
printf '%s\n' "$wan" > /run/aiot3588a2-wan
if [ -n "$wan" ]; then
    ip link set "$wan" up
    udhcpc -b -i "$wan" -p /run/udhcpc-wan.pid >/tmp/udhcpc-wan.log 2>&1 &
    echo 1 > /proc/sys/net/ipv4/ip_forward
    iptables-legacy -t nat -A POSTROUTING -o "$wan" -j MASQUERADE
fi
for attempt in $(seq 1 20); do
    [ ! -d /sys/class/net/wlan0 ] || break
    sleep 1
done
if [ -d /sys/class/net/wlan0 ]; then
    hostapd -B -P /run/hostapd.pid /etc/aiot3588a2-hostapd.conf >/tmp/hostapd.log 2>&1
fi
while :; do
    /usr/sbin/aiot3588a2-issue refresh
    sleep 5
done
